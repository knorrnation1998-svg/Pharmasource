# ---- Persistence -----------------------------------------------------------
# "json"  -> data/inventory.json. Works locally and on any VPS/Docker host.
#            DOES NOT WORK on Vercel/Netlify serverless (read-only filesystem).
# "turso" -> libSQL/SQLite. Free tier is genuinely free (500 DBs, 9GB).
DATA_DRIVER=json

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Admin auth ------------------------------------------------------------
# Generate hash:  node -e "console.log(require('crypto').scryptSync(process.argv[1],'pharmasource',64).toString('hex'))" "YOUR_PASSWORD"
ADMIN_EMAIL=admin@pharmasource.cm
ADMIN_PASSWORD_HASH=
# openssl rand -base64 32
SESSION_SECRET=

# ---- Payments (Flutterwave: supports Cameroon, MoMo, Orange Money, cards) ---
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_HASH=
PAYMENT_PROVIDER=flutterwave
NEXT_PUBLIC_SITE_URL=http://localhost:3000
